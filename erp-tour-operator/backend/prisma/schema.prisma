model LiquidacionReserva {
  id                       Int                     @id @default(autoincrement())
  idReserva                Int                     @unique(map: "uq_liquidacion_reserva") @map("id_reserva")
  totalVentaConfirmada     Decimal                 @map("total_venta_confirmada") @db.Decimal(12, 2)
  totalCostoReal           Decimal                 @map("total_costo_real") @db.Decimal(12, 2)
  utilidadBrutaTotal       Decimal                 @map("utilidad_bruta_total") @db.Decimal(12, 2)
  utilidadPorPersona       Decimal?                @map("utilidad_por_persona") @db.Decimal(12, 2)
  valorAgencia             Decimal?                @map("valor_agencia") @db.Decimal(12, 2)
  diferenciaCotizadoVsReal Decimal?                @map("diferencia_cotizado_vs_real") @db.Decimal(12, 2)
  monedaCodigo             String                  @default("USD") @map("moneda_codigo") @db.Char(3)
  estadoCierre             LiquidacionEstadoCierre @default(ABIERTA) @map("estado_cierre")
  fechaCalculo             DateTime                @map("fecha_calculo")
  fechaCierre              DateTime?               @map("fecha_cierre")
  createdAt                DateTime                @default(now()) @map("created_at")
  updatedAt                DateTime                @updatedAt @map("updated_at")
  reserva                  Reserva                 @relation(fields: [idReserva], references: [id])

  @@index([estadoCierre], map: "idx_liquidacion_estado")
  @@index([fechaCalculo], map: "idx_liquidacion_fecha")
  @@map("liquidacion_reserva")
}

model AuditoriaEvento {
  id            Int      @id @default(autoincrement())
  entidad       String   @db.VarChar(60)
  entidadId     Int      @map("entidad_id")
  accion        String   @db.VarChar(60)
  valorAnterior Json?    @map("valor_anterior")
  valorNuevo    Json?    @map("valor_nuevo")
  fechaEvento   DateTime @default(now()) @map("fecha_evento")
  idUsuario     Int?     @map("id_usuario")
  usuario       Usuario? @relation(fields: [idUsuario], references: [id])

  @@index([entidad, entidadId], map: "idx_auditoria_entidad")
  @@index([fechaEvento], map: "idx_auditoria_fecha")
  @@map("auditoria_evento")
}

model ReservaColumnaSeleccionada {
  id                        Int  @id @default(autoincrement())
  idReserva                 Int  @map("id_reserva")
  idCotizacionColumnaOrigen Int? @map("id_cotizacion_columna_origen")

  grupoSnapshot         String @map("grupo_snapshot") @db.VarChar(80)
  nombreSnapshot        String @map("nombre_snapshot") @db.VarChar(80)
  tipoSnapshot          String @map("tipo_snapshot") @db.VarChar(40)
  unidadSnapshot        String @map("unidad_snapshot") @db.VarChar(40)
  multiplicadorSnapshot Int    @default(1) @map("multiplicador_snapshot")

  precioMostradoFormulaSnapshot String?  @map("precio_mostrado_formula_snapshot") @db.VarChar(120)
  precioMostradoValorSnapshot   Decimal? @map("precio_mostrado_valor_snapshot") @db.Decimal(10, 2)

  orden Int @default(1)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  reserva                 Reserva            @relation(fields: [idReserva], references: [id], onDelete: Cascade)
  cotizacionColumnaOrigen CotizacionColumna? @relation(fields: [idCotizacionColumnaOrigen], references: [id])

  precios          ReservaItemPrecioSeleccionado[]
  hotelesPrevistos ReservaItemHotelPrevistoSeleccionado[]

  @@index([idReserva], map: "idx_reserva_columna_reserva")
  @@index([idCotizacionColumnaOrigen], map: "idx_reserva_columna_origen")
  @@map("reserva_columna_seleccionada")
}

model ReservaItemPrecioSeleccionado {
  id                           Int @id @default(autoincrement())
  idReservaItem                Int @map("id_reserva_item")
  idReservaColumnaSeleccionada Int @map("id_reserva_columna_seleccionada")

  precioCotizado   Decimal? @map("precio_cotizado") @db.Decimal(12, 2)
  precioConfirmado Decimal? @map("precio_confirmado") @db.Decimal(12, 2)
  monedaCodigo     String   @default("USD") @map("moneda_codigo") @db.Char(3)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  reservaItem                ReservaItem                @relation(fields: [idReservaItem], references: [id], onDelete: Cascade)
  reservaColumnaSeleccionada ReservaColumnaSeleccionada @relation(fields: [idReservaColumnaSeleccionada], references: [id], onDelete: Cascade)

  @@unique([idReservaItem, idReservaColumnaSeleccionada], map: "uq_reserva_item_precio_columna")
  @@index([idReservaItem], map: "idx_reserva_item_precio_item")
  @@index([idReservaColumnaSeleccionada], map: "idx_reserva_item_precio_columna")
  @@map("reserva_item_precio_seleccionado")
}

model ReservaItemHotelPrevistoSeleccionado {
  id                           Int @id @default(autoincrement())
  idReservaItem                Int @map("id_reserva_item")
  idReservaColumnaSeleccionada Int @map("id_reserva_columna_seleccionada")

  textoHotel String @map("texto_hotel") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  reservaItem                ReservaItem                @relation(fields: [idReservaItem], references: [id], onDelete: Cascade)
  reservaColumnaSeleccionada ReservaColumnaSeleccionada @relation(fields: [idReservaColumnaSeleccionada], references: [id], onDelete: Cascade)

  @@unique([idReservaItem, idReservaColumnaSeleccionada], map: "uq_reserva_item_hotel_columna")
  @@index([idReservaItem], map: "idx_reserva_item_hotel_item")
  @@index([idReservaColumnaSeleccionada], map: "idx_reserva_item_hotel_columna")
  @@map("reserva_item_hotel_previsto_seleccionado")
}
