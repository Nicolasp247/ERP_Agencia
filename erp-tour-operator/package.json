{
  "name": "erp-tour-operator",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "dev": "concurrently \"pnpm --filter backend dev\" \"pnpm --filter frontend dev\"",
    "build": "pnpm --filter backend build && pnpm --filter frontend build",
    "lint": "eslint \"backend/src/**/*.{ts}\" \"frontend/src/**/*.{ts,tsx}\"",
    "test": "pnpm --filter backend test",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,css}\"",
    "prisma:generate": "pnpm --filter backend exec prisma generate --schema prisma/schema.prisma"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.24.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "typescript-eslint": "^8.29.1"
  }
}